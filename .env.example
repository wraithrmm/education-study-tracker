# The public HTTPS origin Claude will reach, with no trailing slash.
# This must match exactly what you type into the connector dialog.
PUBLIC_URL=https://tracker.example.com

# The password you type on the consent screen when authorising a client.
# Generate one: openssl rand -base64 24
TRACKER_PASSWORD=

# true  = anyone with the URL can read the dashboard (writes still need OAuth)
# false = the dashboard requires a token too
DASHBOARD_PUBLIC=true
